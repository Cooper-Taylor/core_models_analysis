# Caches and generated artifacts
.kbcache/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Heuristic-variant outputs (regenerated by scripts/export_thermo_variants.py)
thermo_variants/

# Site JSON snapshots: ship static-mode files in git, ignore the FBA-only ones.
# If build_site_data.py / build_all_models_impact.py grows a new output,
# decide per-file: add to this list to keep it out of git, or leave it
# alone to ship it.
site/data/baseline.json
site/data/panel.json
# all-models full FBA index + per-model rxn lists — large (~9 MB combined),
# rebuilt by scripts/build_all_models_impact.py in seconds; the summary +
# per-variant files below are what the static UI actually reads.
site/data/all_models_baseline_fba.json
site/data/all_models_rxnsets.json
# Guard against __pycache__ / .pyc accidentally landing under site/data/
# (the top-level __pycache__/ rule above also catches these — belt + braces).
site/data/**/__pycache__/
site/data/**/*.pyc
# Files that DO ship (committed by default — no negation needed because
# nothing above ignores them): manifest.json, reactions_panel.json,
# reactions_other.json, variants/*.json, panel_rxnsets.json (loaded
# client-side by the flux-impacted-rxn filter + rxn-instances column),
# all_models_variants.json (all-DB summary stats per variant),
# all_models_rxnsets_summary.json (per-model rxn-count for "all models" scope),
# all_models_variant_fba__{tag}.json (per-variant all-DB FBA rows used by
# the Variant Browser's "top movers" table in all-models scope).

# Runtime logs
logs/
*.log

# Top-level data dir: symlinks to external locations (users provide their own).
# Anchored with a leading slash so it does not also match site/data/, which
# ships static-mode snapshots in git (see the explicit-deny block above).
/data/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Local Claude Code settings
.claude/

# Virtual envs
.venv/
venv/
env/
results/reaction_effects_all/

# Error-filtered ΔG′° scatter single panels: 72 full-size PNGs (~10 MB) that are
# just the per-slice blow-ups of the committed grid_*.png. Regenerate with
# `python scripts/plot_thermo_source_dg_scatter_filtered.py` (~2m20s). The five
# grids, the README and slice_counts.tsv in that directory DO ship.
reports/thermoComparison/figures/thermo_source_dg_scatter_filtered/sigma/
reports/thermoComparison/figures/thermo_source_dg_scatter_filtered/ehat/

# Same deal for the subtractive companion: 144 single panels (~20 MB) under
# <rule>/<criterion>/<mode>/. Regenerate with
# `python scripts/plot_thermo_source_dg_scatter_subtractive.py`. The nine grids,
# the README and slice_counts_subtractive.tsv DO ship.
reports/thermoComparison/figures/thermo_source_dg_scatter_subtractive/any/
reports/thermoComparison/figures/thermo_source_dg_scatter_subtractive/both/
# --cache pickle of the assembled dg/σ/ê/operator table for those two scripts.
# Pure derived data, ~10 MB, and it has no staleness check — never ship it.
results/thermo_scatter_cache/

# Per-reaction thermo grading / recommendation tables — large (~40 MB combined)
# and fully regenerated by scripts/grade_thermo_sources.py and
# scripts/recommend_thermo_source.py in a few minutes each. The summary tables,
# the calibration JSONs and the direction maps beside them ARE tracked, and
# reports/thermoSourceMethod/tables/ carries its own copies of everything the
# write-up quotes, so the analysis is readable without these.
results/thermo_grades/source_grades.tsv
results/thermo_grades/source_grades_heldout.tsv
results/thermo_grades/source_grades_wide.tsv
results/thermo_grades_fba/rxn_source_coverage.csv
results/thermo_recommendation/recommendation_direction.tsv
results/thermo_recommendation/recommendation_magnitude.tsv
